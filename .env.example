# Save this file as UTF-8 (BOM optional). The PowerShell launchers read it as
# UTF-8, so non-ASCII comments are safe; ANSI/GBK saves can corrupt entries.
# demo uses ETF sample data; live uses your authorized RQData snapshots.
DATA_MODE=demo
FTSHARE_SEED_FILE=data/private/rqdata-seed.json
# 1 enables the ETF activity radar.
ENABLE_RADAR=0
# Shared file written by the separate intraday collector.
FTSHARE_LIVE_CACHE_FILE=data/private/rqdata-live.json
# Optional Python crowding archive base path.
# CROWDING_FILE=data/private/rqdata-crowding.json
# Optional per-ETF burst monitoring paths.
# ETF_BURST_DIR=data/private/etf-burst
# ETF_BURST_CONFIG=config/etf-burst.json
# Optional daily source registry (RQData default; DDB optional).
# FTSHARE_SOURCE_CONFIG=config/data-sources.json
# DDB daily source credentials (only needed to build the DDB seed).
# DDB_HOST=10.72.236.101
# DDB_PORT=8963
# DDB_USER=wuzy
# DDB_PASSWORD=
# Optional local JSON settings for an RQData market collector. See docs/getting-started/configuration.md.
# MARKET_DATA_CONFIG_FILE=.local/rqdata-market.json
# Python interpreter for scripts/python-backend.ps1, e.g. a conda env:
#   RQDATA_PYTHON=D:\anaconda\envs\rqsdk\python.exe
# RQDATA_PYTHON=python
# RQDATA_CREDENTIAL_FILE=
HOST=127.0.0.1
PORT=8080
